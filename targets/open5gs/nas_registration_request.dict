registration_type_mobility="\x02"
registration_type_periodic="\x03"
registration_type_emergency="\x04"

len_0="\x00"
len_1="\x01"
len_2="\x02"
len_3="\x03"
len_4="\x04"
len_8="\x08"
len_16="\x10"

zero_byte="\x00"
ff_byte="\xff"
padding_zeros="\x00\x00\x00\x00"
padding_ff="\xff\xff\xff\xff"

mobile_identity_empty="\x00"
mobile_identity_short="\x01\x00"
mobile_identity_pattern="\x01\x02\x03\x04"
mobile_identity_ff="\xff\xff\xff\xff"

ie_ue_security_capability="\x2e"
ie_requested_nssai="\x2f"
ie_last_visited_registered_tai="\x52"
